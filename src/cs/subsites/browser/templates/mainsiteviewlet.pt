<tal:condition tal:define="
                 is_subsite view/is_subsite;
               "
               tal:condition="is_subsite"
>
  <div class="mainsiteviewlet">
    <a tal:attributes="
         href view/mainsite_url;
       ">
      <img width="80px"
           tal:attributes="
             src view/mainsite_logo;
           "
      />
    </a>
  </div>
</tal:condition>
