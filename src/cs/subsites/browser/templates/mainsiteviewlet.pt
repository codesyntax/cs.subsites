<tal:condition tal:define="is_subsite view/is_subsite" tal:condition="is_subsite">
        <div class="mainsiteviewlet">
                <a tal:attributes="href view/mainsite_url">
                        <img width="80px" tal:attributes="src string:${view/mainsite_url}/@@site-logo/logo.png" />
                </a>
        </div>
</tal:condition>