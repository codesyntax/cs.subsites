<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="cs.subsites"
    >

  <!-- -*- extra stuff goes here -*- -->
  <browser:viewlet
      name="cs.subsite.footer"
      for="*"
      manager="plone.app.layout.viewlets.interfaces.IPortalFooter"
      class=".footer.Footer"
      template="templates/footer.pt"
      permission="zope2.View"
      layer="..interfaces.ICSSubsitesLayer"
      />

  <browser:viewlet
      name="cs.subsite.mainsite"
      for="*"
      manager="plone.app.layout.viewlets.interfaces.IPortalHeader"
      class=".mainsiteviewlet.MainSiteViewlet"
      template="templates/mainsiteviewlet.pt"
      permission="zope2.View"
      layer="..interfaces.ICSSubsitesLayer"
      />

  <browser:viewlet
      name="cs.subsites.specificcss"
      for="*"
      manager="plone.app.layout.viewlets.interfaces.IHtmlHeadLinks"
      class=".specificcssviewlet.SpecificCss"
      template="templates/specificcss.pt"
      permission="zope2.View"
      layer="..interfaces.ICSSubsitesLayer"
      />

  <browser:page
      name="issubsite"
      for="*"
      class=".issubsite.IsSubsite"
      permission="zope.Public"
      layer="..interfaces.ICSSubsitesLayer"
      />

  <browser:page
      name="specificcss.css"
      for="*"
      class=".specificcss.SpecificCss"
      permission="zope.Public"
      layer="..interfaces.ICSSubsitesLayer"
      />

  <adapter
      factory=".bodyclass.ContentBodyClasses"
      name="subsite-bodyclasses"
      />

  <!-- Language Control Panel -->
  <browser:page
      name="language-controlpanel"
      for="cs.subsites.subsite.ISubSite"
      class="Products.CMFPlone.controlpanel.browser.language.LanguageControlPanel"
      permission="plone.app.controlpanel.Language"
      layer="..interfaces.ICSSubsitesLayer"
      />


</configure>
